{
  "name": "animation-studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:web": "node scripts/web.mjs dev",
    "dev:video": "remotion studio src/video/index.ts --port=3000",
    "build:web": "node scripts/web.mjs build",
    "build:video": "remotion bundle src/video/index.ts --out-dir=output/bundle",
    "preview:web": "vite preview --host 127.0.0.1",
    "render": "remotion render src/video/index.ts",
    "still": "remotion still src/video/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "check": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@react-three/fiber": "9.8.1",
    "@remotion/gsap": "4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/three": "4.0.534",
    "gsap": "3.15.0",
    "p5": "2.3.4",
    "p5.brush": "2.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534",
    "three": "0.186.1",
    "tweakpane": "4.0.5"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/eslint-config-flat": "4.0.534",
    "@tweakpane/core": "2.0.5",
    "@types/node": "24.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "playwright": "1.64.0",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  }
}
